# SQLite database used for local development
DATABASE_URL="file:./dev.db"

# Set a random value of at least 32 characters in production.
JWT_SECRET=""

# Optional server-side TMDB credentials for catalogue imports.
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""

# Optional server-side key for Hyderabad showtime imports.
SERP_SEARCH_API_KEY=""
# Bright Data zone used by the Hyderabad search integration.
BRIGHTDATA_ZONE=""

# Shared secret for the browser showtime-capture extension. Keep it private.
SHOWTIME_INGEST_KEY=""

# Optional monitor worker settings.
MONITOR_INTERVAL_MINUTES="20"
MONITOR_MAX_JOBS_PER_CYCLE="3"

# Optional Brevo API email delivery. Without BREVO_API_KEY, email content is logged locally.
BREVO_API_KEY=""
# Verified sender email in Brevo (variable name retained for compatibility).
SMTP_FROM="alerts@example.com"
