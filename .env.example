# SQLite file DB - works out of the box, no setup needed
DATABASE_URL="file:./dev.db"

# Railway production uses a PostgreSQL URL supplied by its Postgres service.
# Do not replace the local SQLite URL above while developing on this computer.

# Secret used to sign login session tokens - change this to any random string
JWT_SECRET="change-this-to-a-long-random-string"

# Server-only TMDB v3 key for automatic current/upcoming movie catalogue imports
TMDB_API_KEY=""
# Optional v4 Read Access Token (Bearer authentication; preferred if present)
TMDB_READ_ACCESS_TOKEN=""

# Server-only SERP Search key for Hyderabad cinema showtime imports
SERP_SEARCH_API_KEY=""

# Random shared secret used only by your local browser showtime-capture extension.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOWTIME_INGEST_KEY=""

# Optional: needed for real ticket-alert and password-reset OTP emails (without it, messages are logged locally)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@example.com"
